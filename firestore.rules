rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == "showroomvatlieutanphat@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Site Data Validation
    function isValidSiteData(data) {
      return data.keys().hasAll(['header', 'features', 'video', 'contactLinks']) &&
             data.header is map &&
             data.features is list &&
             data.video is map &&
             data.contactLinks is list;
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && isAdmin() && isValidSiteData(request.resource.data);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or specialized tool
    }
  }
}
